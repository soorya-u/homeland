{
  "name": "@homeland/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client/web": {
      "default": "./src/client/web.ts"
    },
    "./client/mobile": {
      "default": "./src/client/mobile.ts"
    },
    "./plugins/server": {
      "default": "./src/plugins/server.ts"
    },
    "./plugins/client": {
      "default": "./src/plugins/client.ts"
    },
    "./casbin": {
      "default": "./src/casbin.ts"
    },
    "./middleware": {
      "default": "./src/middleware.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "generate": "bun x @better-auth/cli generate -y --config src/index.ts --output ../db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@homeland/db": "workspace:*",
    "@homeland/env": "workspace:*",
    "better-auth": "catalog:",
    "casbin": "catalog:",
    "drizzle-adapter": "catalog:",
    "nanostores": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@homeland/config": "workspace:*",
    "typescript": "catalog:"
  }
}
